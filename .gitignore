# SearXNG Docker (Practice/searxng-docker)
#
# Using SearXNG as a Docker service — keep only our Docker configuration.
# Do NOT commit the cloned SearXNG upstream source code.

Practice/searxng-docker/**

# Keep only our Docker setup
!Practice/searxng-docker/container/
Practice/searxng-docker/container/**
!Practice/searxng-docker/container/docker-compose.yml
!Practice/searxng-docker/container/core-config/
Practice/searxng-docker/container/core-config/**
!Practice/searxng-docker/container/core-config/settings.yml

# Upstream repo git metadata
Practice/searxng-docker/.git/
Practice/searxng-docker/.github/
Practice/searxng-docker/.gitignore
Practice/searxng-docker/.gitattributes

# Upstream .gitignore patterns (from Practice/searxng-docker/.gitignore)
Practice/searxng-docker/**/*.pyc
Practice/searxng-docker/**/*~
Practice/searxng-docker/**/*.swp
Practice/searxng-docker/**/geckodriver.log
Practice/searxng-docker/**/.coverage
Practice/searxng-docker/**/coverage/
Practice/searxng-docker/**/.govm/
Practice/searxng-docker/**/.nvm/
Practice/searxng-docker/**/cache/
Practice/searxng-docker/**/build/
Practice/searxng-docker/**/dist/
Practice/searxng-docker/**/local/
Practice/searxng-docker/**/gh-pages/
Practice/searxng-docker/**/searx/version_frozen.py
Practice/searxng-docker/**/.dir-locals.el
Practice/searxng-docker/**/.python-version

